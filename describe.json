{
  "tools": [
    {
      "name": "vrc_status",
      "tags": [
        "read"
      ],
      "summary": "VRChat 通不通",
      "description": "看 VRChat 那边通不通：OSC 有没有动静、当前化身、chatbox 队列里有没有排着的句子。VRChat 没开会说 offline，不是报错。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    {
      "name": "vrc_say",
      "tags": [
        "speak"
      ],
      "barrierAfter": true,
      "summary": "在 VRChat 里说一句",
      "description": "在 VRChat 里说一句话：进游戏聊天框（超长自动分条、按间隔排队），配置开了语音的话同时出声。",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "voice": {
            "type": "boolean"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "vrc_text",
      "tags": [
        "speak"
      ],
      "barrierAfter": true,
      "summary": "只出字",
      "description": "只往游戏聊天框发文字，不出声。",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "vrc_typing",
      "tags": [
        "read"
      ],
      "summary": "正在输入",
      "description": "在 VRChat 里显示/取消「正在输入」。",
      "parameters": {
        "type": "object",
        "properties": {
          "on": {
            "type": "boolean"
          }
        },
        "required": [
          "on"
        ]
      }
    },
    {
      "name": "vrc_voice",
      "tags": [
        "speak"
      ],
      "barrierAfter": true,
      "summary": "只出声",
      "description": "只出声不出字（小声嘀咕用）。",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "vrc_param",
      "tags": [
        "write"
      ],
      "summary": "设化身参数",
      "description": "设一个化身参数（只在 paramEnabled 打开时可用）。",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "name",
          "value"
        ]
      }
    },
    {
      "name": "vrc_erp",
      "tags": [
        "speak"
      ],
      "barrierAfter": true,
      "summary": "成人向角色扮演",
      "description": "ERP 状态机：start 开始（可带 scene）/ stop 结束 / stage 跳阶段（target）/ next 推一阶段 / say 说一句（text，mode=normal|whisper|moan）/ act 动作旁白（text）/ status 状态。台词按配置决定进不进 chatbox、出不出声；没 start 前 say/act 不发东西。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "start",
              "stop",
              "stage",
              "next",
              "say",
              "act",
              "status"
            ]
          },
          "scene": {
            "type": "string"
          },
          "target": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "normal",
              "whisper",
              "moan"
            ]
          }
        },
        "required": [
          "action"
        ]
      }
    }
  ],
  "events": [],
  "prompts": [
    {
      "key": "worlds.vrc.envPrompt",
      "title": "VRChat · 环境提示词",
      "role": "envPrompt",
      "content": "{{vrc.state}}\n（这是 VRChat 的在线状态。要在里面说话用 vrc_say；只出字用 vrc_text；出声用 vrc_voice。没在线就别硬发，chatbox 那边看不见。）"
    }
  ]
}
