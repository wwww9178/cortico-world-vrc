{
  "name": "cortico-world-vrc",
  "version": "0.2.0",
  "description": "Coopanion 的 VRChat 世界扩展：经官方 OSC 让桌宠在游戏里说话（chatbox 文字 + 虚拟声卡语音）",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "voice",
    "tools",
    "examples",
    "describe.json",
    "ENV_PROMPT.md",
    "ERP_PROMPT.md",
    "README.md",
    "LICENSE",
    "PLAN.md",
    "PUBLISH.md",
    "test",
    "CHANGELOG.md"
  ],
  "keywords": [
    "cortico",
    "coopanion",
    "vrchat",
    "osc",
    "chatbox",
    "desktop-pet",
    "tts"
  ],
  "license": "MIT",
  "author": "cortico-world-vrc contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wwww9178/cortico-world-vrc.git"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "label": "VRChat",
    "describe": "describe.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test \"test/*.test.mjs\"",
    "listen": "node --experimental-strip-types tools/vrc-cli.mjs listen",
    "send": "node --experimental-strip-types tools/vrc-cli.mjs send",
    "break": "node tools/apply-break.mjs"
  },
  "bugs": {
    "url": "https://github.com/wwww9178/cortico-world-vrc/issues"
  },
  "homepage": "https://github.com/wwww9178/cortico-world-vrc#readme"
}
